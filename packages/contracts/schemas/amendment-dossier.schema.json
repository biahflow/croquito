{
  "$defs": {
    "AmendmentDossierItem": {
      "additionalProperties": false,
      "description": "Um item confirmado no takeoff cujo código foi rejeitado: candidato a aditivo.\n\nNenhum campo de preço existe aqui, por construção: o dossiê instrui o pedido de\naditivo, nunca o precifica. `justification` é a `decision.note` da rejeição de\ncódigo, nunca inventada; `item_note` é a anotação que já acompanhava o item na\nlegenda (ex.: `h=1.00m`), distinta da justificativa da rejeição.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/ReviewerDecision"
        },
        "evidence": {
          "$ref": "#/$defs/PlateEvidence"
        },
        "item_id": {
          "pattern": "^ti_[a-f0-9]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_note": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Note"
        },
        "justification": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Quantity",
          "type": "string"
        },
        "raw_text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "unit": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "label",
        "raw_text",
        "quantity",
        "unit",
        "justification",
        "decision",
        "evidence"
      ],
      "title": "AmendmentDossierItem",
      "type": "object"
    },
    "PlateBox": {
      "additionalProperties": false,
      "description": "Espelho de `PixelBox`: recorte em pixels da prancha onde o item foi lido.",
      "properties": {
        "bottom": {
          "exclusiveMinimum": 0,
          "title": "Bottom",
          "type": "integer"
        },
        "left": {
          "minimum": 0,
          "title": "Left",
          "type": "integer"
        },
        "right": {
          "exclusiveMinimum": 0,
          "title": "Right",
          "type": "integer"
        },
        "top": {
          "minimum": 0,
          "title": "Top",
          "type": "integer"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "PlateBox",
      "type": "object"
    },
    "PlateEvidence": {
      "additionalProperties": false,
      "description": "Espelho de `EvidenceRegion`: âncora da prancha para a linha da legenda lida.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/PlateBox"
        },
        "coordinate_space": {
          "const": "source_image_pixels",
          "default": "source_image_pixels",
          "title": "Coordinate Space",
          "type": "string"
        },
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "plate_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Plate Id",
          "type": "string"
        }
      },
      "required": [
        "plate_id",
        "page_number",
        "image_sha256",
        "bbox"
      ],
      "title": "PlateEvidence",
      "type": "object"
    },
    "ReviewerDecision": {
      "additionalProperties": false,
      "description": "Decisão humana rastreável do orçamentista.\n\nDuplicação local deliberada do `HumanDecision` do contexto de cena: o ADR-0016 mantém\nos dois contextos separados, e uma decisão sobre medição não é uma decisão sobre\ngeometria. O que se repete é a forma, não o significado.",
      "properties": {
        "action": {
          "enum": [
            "confirm",
            "reject"
          ],
          "title": "Action",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^vd_[a-f0-9]{16}$",
          "title": "Decision Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reviewer_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewer_role": {
          "const": "orcamentista",
          "title": "Reviewer Role",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "action",
        "reviewer_id",
        "reviewer_role",
        "decided_at"
      ],
      "title": "ReviewerDecision",
      "type": "object"
    }
  },
  "$id": "https://schemas.croquito.local/valuation/amendment-dossier/1.0.0.json",
  "additionalProperties": false,
  "description": "Dossiê do aditivo de uma prancha.\n\nLista `items` vazia é desfecho normal: uma rodada sem nenhuma rejeição de código não\ntem aditivo, e isso não é uma condição de erro.",
  "properties": {
    "catalog_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "contract_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contract Sha256"
    },
    "image_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Image Sha256",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AmendmentDossierItem"
      },
      "title": "Items",
      "type": "array"
    },
    "page_number": {
      "minimum": 1,
      "title": "Page Number",
      "type": "integer"
    },
    "plate_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Plate Id",
      "type": "string"
    },
    "safety_notes": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Safety Notes",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_pdf_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Pdf Sha256",
      "type": "string"
    }
  },
  "required": [
    "plate_id",
    "page_number",
    "image_sha256",
    "source_pdf_sha256",
    "catalog_sha256",
    "items",
    "safety_notes"
  ],
  "title": "Croquito Amendment Dossier",
  "type": "object"
}
