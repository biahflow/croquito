{
  "name": "croquito-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/field",
    "packages/contracts"
  ],
  "scripts": {
    "contracts:generate": "npm --workspace @croquito/contracts run generate",
    "contracts:check": "npm --workspace @croquito/contracts run check",
    "web:dev": "npm --workspace @croquito/web run dev",
    "web:check": "npm --workspace @croquito/web run check",
    "web:test": "npm --workspace @croquito/web run test",
    "field:dev": "npm --workspace @croquito/field run dev",
    "field:check": "npm --workspace @croquito/field run check",
    "field:test": "npm --workspace @croquito/field run test"
  }
}

