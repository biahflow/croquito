# Copie para apps/medicao/.env.local. Só variáveis VITE_* são lidas pelo Vite.
# O servidor local de homologação sobe com
# `uv run croquito-valuation serve --root <rodada> --reviewer <id>`; ele não tem
# autenticação, e a identidade do revisor vem da flag do processo, não desta UI.
VITE_MEDICAO_API_BASE_URL=http://localhost:8801
