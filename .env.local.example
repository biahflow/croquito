# Copie para .env.local (arquivo ignorado pelo Git) antes de executar make dev-api.
# Estes valores são exclusivos do Docker Compose local.
CROQUITODXF_DATABASE_URL=postgresql+psycopg://croquitodxf:local-dev-only@127.0.0.1:5432/croquitodxf
CROQUITODXF_AWS_ENDPOINT_URL=http://127.0.0.1:4566
CROQUITODXF_ARTIFACT_BUCKET=croquitodxf-local-artifacts
CROQUITODXF_PROCESSING_QUEUE_URL=http://127.0.0.1:4566/000000000000/croquitodxf-local-processing
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=sa-east-1
CROQUITODXF_OIDC_ISSUER=http://localhost:8083/realms/croquitodxf
CROQUITODXF_OIDC_AUDIENCE=croquitodxf-web
CROQUITODXF_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# O front usa apps/web/.env.local; não declare variáveis VITE_* aqui, elas seriam ignoradas.

# Aceita tokens `test:<tenant>:<subject>:<papéis>` sem assinatura. Mantenha desligado:
# só o smoke local (make smoke-local) precisa disso, porque o realm desabilita
# direct access grants e não existe token fora do browser.
CROQUITODXF_ALLOW_TEST_TOKENS=false

# Providers reais permanecem desligados sem este opt-in e entitlement contratual por tenant.
# Nunca versione chaves reais.
CROQUITODXF_REAL_PROVIDERS_ENABLED=false
CROQUITODXF_AI_MAX_ESTIMATED_COST_USD=5.00
CROQUITODXF_AI_ESTIMATED_COST_PER_LLM_CALL_USD=0.75
CROQUITODXF_AI_ESTIMATED_COST_PER_TEXTRACT_CALL_USD=0.02
CROQUITODXF_PROVIDER_TIMEOUT_SECONDS=30
CROQUITODXF_OPENAI_API_KEY=
CROQUITODXF_OPENAI_MODEL=gpt-5.6-terra
# Não usa o endpoint LocalStack: Bedrock e Textract são chamados na AWS configurada.
CROQUITODXF_AWS_PROVIDER_REGION=sa-east-1
CROQUITODXF_BEDROCK_MODEL=global.anthropic.claude-sonnet-5
