# Copie para .env.local (arquivo ignorado pelo Git) antes de executar make dev-api.
# Estes valores são exclusivos do Docker Compose local.
CROQUITO_DATABASE_URL=postgresql+psycopg://croquito:local-dev-only@127.0.0.1:5432/croquito
CROQUITO_AWS_ENDPOINT_URL=http://127.0.0.1:4566
CROQUITO_ARTIFACT_BUCKET=croquito-local-artifacts
CROQUITO_PROCESSING_QUEUE_URL=http://127.0.0.1:4566/000000000000/croquito-local-processing
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=sa-east-1
CROQUITO_OIDC_ISSUER=http://localhost:8083/realms/croquito
CROQUITO_OIDC_AUDIENCE=croquito-web
CROQUITO_WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Perfil do object store. `s3` (padrão) assina o checksum no PUT e usa SSE-S3 explícita.
# `gcs` é a interoperabilidade XML do Cloud Storage, que recusa os dois: lá o digest é
# conferido pelo worker ao reler os bytes e a criptografia em repouso é do próprio bucket.
CROQUITO_STORAGE_FLAVOR=s3
CROQUITO_STORAGE_SSE=true

# Fila de processamento. Com o tópico preenchido a API publica no Pub/Sub em vez do SQS,
# com o mesmo corpo de mensagem; vazio mantém o SQS.
CROQUITO_PUBSUB_TOPIC=

# Disponibilidade de cada jornada NESTE ambiente: `enabled` (todos os tenants), `pilot`
# (só tenants com entitlement em tenant_journey_entitlements) ou `disabled` (não existe
# aqui). Ausente equivale a `enabled`; valor diferente destes três recusa na subida da API.
CROQUITO_JOURNEY_CROQUI=enabled
CROQUITO_JOURNEY_MEDICAO=enabled
CROQUITO_JOURNEY_ORCAMENTO=enabled
# Tópico dos EVENTOS DE DOMÍNIO publicados para fora (ADR-0042), lido só pelo relay
# `croquito-demo publish-events --sink pubsub`. Nada a ver com a fila acima, que é comando
# interno API↔worker. Vazio é o normal em desenvolvimento: use `--sink file --path`, que
# grava JSONL local e não fala com nuvem nenhuma.
CROQUITO_DOMAIN_EVENTS_TOPIC=

# O front usa apps/web/.env.local; não declare variáveis VITE_* aqui, elas seriam ignoradas.

# Aceita tokens `test:<tenant>:<subject>:<papéis>` sem assinatura. Mantenha desligado:
# só o smoke local (make smoke-local) precisa disso, porque o realm desabilita
# direct access grants e não existe token fora do browser.
CROQUITO_ALLOW_TEST_TOKENS=false

# Providers reais permanecem desligados sem este opt-in e entitlement contratual por tenant.
# Nunca versione chaves reais.
CROQUITO_REAL_PROVIDERS_ENABLED=false
CROQUITO_AI_MAX_ESTIMATED_COST_USD=5.00
CROQUITO_AI_ESTIMATED_COST_PER_LLM_CALL_USD=0.75
CROQUITO_AI_ESTIMATED_COST_PER_TEXTRACT_CALL_USD=0.02
# Teto de segurança do round-trip de cada braço LLM, não alvo de latência: medições reais
# de extração de medida foram 42s (2026-09-02) e 45,1s (2026-09-04); 30s (e o antigo
# default de 60s) estourava e derrubava o retry por consumir a reserva sem devolver — ver
# `DEFAULT_LLM_TIMEOUT_SECONDS` em providers.py e a issue #137.
CROQUITO_PROVIDER_TIMEOUT_SECONDS=120
CROQUITO_OPENAI_API_KEY=
CROQUITO_OPENAI_MODEL=gpt-5.6-terra
# Eixo Anthropic. É o braço PADRÃO da extração de legenda da medição/orçamento
# (`sonnet=anthropic:claude-sonnet-5`, `MEDICAO_EXTRACTION_ARM`), e sem esta chave a
# construção dos providers reais falha inteira — não só o eixo dela. A chave sai do
# console da Anthropic; nunca versione o valor.
CROQUITO_ANTHROPIC_API_KEY=
CROQUITO_ANTHROPIC_MODEL=claude-opus-5
# Não usa o endpoint do emulador local: Bedrock e Textract são chamados na AWS configurada.
CROQUITO_AWS_PROVIDER_REGION=sa-east-1
CROQUITO_BEDROCK_MODEL=global.anthropic.claude-sonnet-5
